{
  "storage": {
    "max_db_size_mb": 500
  },
  "scopes": {
    "mappings": {
      "/home/user/projects/api": "project:api",
      "/home/user/projects/web": "project:web"
    },
    "default": "global",
    "search_order": "project_first"
  },
  "recall": {
    "default_max_tokens": 200,
    "default_depth": "auto",
    "sufficiency": {
      "coverage_threshold": 0.7,
      "confidence_threshold": 0.6
    }
  },
  "embeddings": {
    "model": "all-MiniLM-L6-v2",
    "batch_size": 32
  },
  "facts": {
    "extraction_method": "local",
    "min_confidence": 0.5
  },
  "decay": {
    "lambda": 0.05,
    "recalculate_interval_hours": 6,
    "min_score": 0.01
  },
  "deduplication": {
    "similarity_threshold": 0.92,
    "merge_strategy": "append"
  },
  "learning": {
    "enabled": true,
    "confirmations": 3,
    "min_contexts": 2,
    "max_context_tokens": 180,
    "max_session_tokens": 600,
    "max_lesson_tokens": 80,
    "max_items": 5,
    "capture_tools": false,
    "project_memory": true,
    "semantic_enabled": true,
    "semantic_model": "sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2",
    "semantic_merge_threshold": 0.88,
    "semantic_recall_threshold": 0.65,
    "semantic_timeout_ms": 250,
    "max_detail_tokens": 600,
    "experience_ttl_days": 90,
    "measure_usage": true
  },
  "reliability": {
    "auto_backup": true,
    "backup_interval_hours": 6,
    "backup_keep": 16,
    "auto_checkpoints": true,
    "mirror_directory": "",
    "web_port": 37800
  }
}
